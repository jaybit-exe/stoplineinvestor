// Cloudflare Worker + static assets config for Stopline.
// Placeholders: replace YOUR_* values (or set CLOUDFLARE_ACCOUNT_ID in the environment and delete account_id).
{
  "name": "stopline",                       // the production Worker uses its own name; pick any name for your fork
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "main": "worker/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Optional: only needed for Google sign-in + cross-device sync (/api/*). The calculators work without it.
  "d1_databases": [
    { "binding": "DB", "database_id": "YOUR_D1_DATABASE_ID", "database_name": "stopline" }
  ],
  "vars": { "GOOGLE_CLIENT_ID": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com" }
}
